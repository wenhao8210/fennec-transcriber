# Optional local configuration. Copy to .env; never commit .env.
# run.sh loads this as shell syntax. The native app uses its inherited environment.
FENNEC_DATA_DIR="$HOME/Library/Application Support/com.kkapp.fennec/datas"
FENNEC_WHISPER_MODEL=small
FENNEC_WHISPER_LANGUAGE=zh
FENNEC_SPEAKER_THRESHOLD=0.55
# Override the application's own storage (database, settings, cache).
# FENNEC_STORAGE_DIR="$HOME/.local/share/fennec-transcriber"
# Cloud mode is optional. Supply YOUR OWN credentials locally.
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_WORKSPACE=
# Balance lookup is optional and needs a separate read-only RAM AccessKey.
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
